{
  "rules": {
    ".read": true,
    "wall": {
      ".indexOn": [
        "t"
      ],
      "$cell": {
        ".write": "newData.exists()",
        ".validate": "$cell.matches(/^([0-9]|[1-7][0-9])_([0-9]|[1-3][0-9])$/) && newData.hasChildren(['c', 't']) && newData.child('t').val() == now",
        "c": {
          ".validate": "newData.isString() && (newData.val().matches(/^#[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]$/) || newData.val() == 'none')"
        },
        "t": {
          ".validate": "newData.val() == now"
        },
        "n": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
        },
        "s": {
          ".validate": "newData.val() == 'web' || newData.val() == 'rbx'"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "blocks": {
      ".indexOn": [
        "t"
      ],
      "$cell": {
        ".write": "newData.exists()",
        ".validate": "$cell.matches(/^(0|-?([1-9]|[1-9][0-9]|[1-4][0-9][0-9]|500))_([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])_(0|-?([1-9]|[1-9][0-9]|[1-4][0-9][0-9]|500))$/) && newData.hasChildren(['c', 't']) && newData.child('t').val() == now",
        "c": {
          ".validate": "newData.isString() && (newData.val().matches(/^#[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]$/) || newData.val() == 'none')"
        },
        "t": {
          ".validate": "newData.val() == now"
        },
        "n": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
        },
        "s": {
          ".validate": "newData.val() == 'web' || newData.val() == 'rbx'"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "web": {
      "$id": {
        ".write": true,
        ".validate": "$id.matches(/^w[a-z0-9]+$/) && $id.length <= 17 && newData.hasChildren(['n', 'c', 'x', 'y', 'z', 'r', 't']) && newData.child('t').val() == now",
        "n": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
        },
        "c": {
          ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]$/)"
        },
        "x": {
          ".validate": "newData.isNumber() && newData.val() >= -2048 && newData.val() <= 2048"
        },
        "y": {
          ".validate": "newData.isNumber() && newData.val() >= -50 && newData.val() <= 600"
        },
        "z": {
          ".validate": "newData.isNumber() && newData.val() >= -2048 && newData.val() <= 2048"
        },
        "r": {
          ".validate": "newData.isNumber() && newData.val() >= -10 && newData.val() <= 10"
        },
        "m": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "mt": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "t": {
          ".validate": "newData.val() == now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "rbx": {
      "$uid": {
        ".write": true,
        ".validate": "$uid.matches(/^-?[0-9]+$/) && $uid.length <= 16 && newData.hasChildren(['n', 'x', 'y', 'z', 'r', 'ch', 'ct', 'ca', 'cl', 't']) && newData.child('t').val() == now",
        "n": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
        },
        "x": {
          ".validate": "newData.isNumber() && newData.val() >= -2048 && newData.val() <= 2048"
        },
        "y": {
          ".validate": "newData.isNumber() && newData.val() >= -50 && newData.val() <= 600"
        },
        "z": {
          ".validate": "newData.isNumber() && newData.val() >= -2048 && newData.val() <= 2048"
        },
        "r": {
          ".validate": "newData.isNumber() && newData.val() >= -10 && newData.val() <= 10"
        },
        "ch": {
          ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]$/)"
        },
        "ct": {
          ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]$/)"
        },
        "ca": {
          ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]$/)"
        },
        "cl": {
          ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]$/)"
        },
        "m": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "mt": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "t": {
          ".validate": "newData.val() == now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
